# ==========================================
# Ren'Py Core Engine & Runtime Files
# ==========================================
/game/saves/
/game/cache/
saves/
cache/

# Compiled script files generated by Ren'Py
/game/**/*.rpyc
/game/**/*.rpymc

# Temporary & backup script files
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and diagnostic output files
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated translation & dialogue dumps
/dialogue.tab
/dialogue.txt
/strings.json

# Ren'Py Build Distribution Output
/build/

# ==========================================
# Python Backend Cache Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# IDE & Code Editor Metadata
# ==========================================
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Operating System Junk Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

